    "@trpc/server": "^11.0.0-rc.682",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "groq-sdk": "^1.1.1",
    "hono": "^4.6.16",
    "jsonrepair": "^3.14.0",
    "linkedom": "^0.18.12",
    "node-cron": "^4.2.1",
    "openai": "^6.27.0",
    "rss-parser": "^3.13.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.9",
