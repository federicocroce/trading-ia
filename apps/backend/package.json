    "db:import-buenbit": "tsx src/db/import-buenbit.ts",
    "db:reresolve-signals": "tsx src/scripts/reresolve-signal-tracking.ts",
    "db:backfill-r": "tsx src/scripts/backfill-r-multiple.ts",
    "db:backfill-hoy": "tsx src/scripts/backfill-today-proposals.ts",
    "db:backfill-benchmark": "tsx src/scripts/backfill-benchmark-alpha.ts",
    "db:repair-journal": "tsx src/scripts/repair-migration-timestamps.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
