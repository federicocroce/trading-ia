ANTHROPIC_API_KEY=sk-ant-xxxxx
PORT=3001
FRONTEND_URL=http://localhost:5173
BIND_HOST=127.0.0.1           # interfaz de escucha. NO hay auth en tRPC: exponerlo a 0.0.0.0
                              # deja la cartera legible por cualquiera en la misma red

# Salida por cierre confirmado (vista "Hoy"): 1 = un stop tocado en sesión NO
# confirma venta, se decide por el cierre. Ver docs/IA/prompt-maestro (§decisión).
EXIT_ON_CLOSE=1

# Símbolo contra el que se mide el costo de oportunidad de cada señal
# (columnas benchmark_return / alpha_vs_benchmark de signal_tracking).
# Sin esto el sistema mide contra CERO en vez de contra "comprar el índice y no
# hacer nada". Backfill histórico: npm run db:backfill-benchmark --workspace=apps/backend
BENCHMARK_SYMBOL=SPY

# Nominación por ATENCIÓN (prensa, búsqueda web, LLM): ¿pueden meter tickers al universo?
# APAGADO por default desde 2026-07-27. Medido contra el índice, ese bloque rinde mediana
# -6.20% (t=-3.05, n=1.928) — nomina PEOR que no nominar. Las noticias siguen alimentando
# macro_events, contexto causal y digest: lo único que se apagó es su poder de decidir QUÉ
# MIRA el scan. Poner en 1 para re-encenderlo y volver a medirlo (queda etiquetado como
# source='news'/'web_search'/'llm' en discovered_symbols).
DISCOVERY_ATTENTION_NOMINATION=0

# Candidatos que el barrido de bases (sábados) puede registrar por corrida.
# 15 -> 30 el 2026-07-27: en su única corrida real registró 11 de 15, el cap ataba.
SWEEP_MAX_CANDIDATES=30

# Groq — soporta hasta 4 keys con rotación automática (30 req/min x key)
# Crear keys gratis en https://console.groq.com
GROQ_API_KEY_1=gsk_xxxxx
GROQ_API_KEY_2=gsk_xxxxx
GROQ_API_KEY_3=gsk_xxxxx
GROQ_API_KEY_4=gsk_xxxxx

# Google AI Studio — hasta 4 keys con rotación (fallback cuando Groq no alcanza)
GOOGLE_AI_API_KEY_1=AIzaxxxxx
GOOGLE_AI_API_KEY_2=AIzaxxxxx
GOOGLE_AI_API_KEY_3=AIzaxxxxx
GOOGLE_AI_API_KEY_4=AIzaxxxxx

# LM Studio (local LLM - no API key needed)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# News sources (all optional - system works with Yahoo Finance alone)
FINNHUB_API_KEY=

NEWSAPI_API_KEY=
RSS_FEEDS=https://www.cnbc.com/id/100003114/device/rss/rss.html,https://feeds.marketwatch.com/marketwatch/topstories/,https://www.investing.com/rss/news.rss

# Web search (pipeline stage 1)
TAVILY_API_KEY=          # required — primary provider
EXA_API_KEY=             # optional — fallback provider

# Barrera de calidad del universo (anti small-caps basura)
MIN_MARKET_CAP_USD=500000000
MIN_QUALITY_PRICE_USD=5

# Timeout por llamada LLM (ms) — una llamada colgada no puede bloquear el pipeline
LLM_TIMEOUT_MS=90000

# Chat agéntico (Agent SDK — usa el login de Claude Code, sin API key)
CHAT_AGENT_TIMEOUT_MS=120000   # timeout por INACTIVIDAD del agente (se resetea con cada evento)
CHAT_AGENT_MODEL=sonnet        # sonnet | opus | haiku | id completo de modelo

# Score mínimo para alertar un re-armado (setup invalid ayer → operable hoy)
REARM_MIN_SCORE=55

# Screener de mercado (embudo: quality bar → anti-chase → SMA200 → setup válido + RR)
SCREENER_MAX_DAY_MOVE_PCT=15   # anti-chase: descarta candidatos que ya se movieron más de ±15% en el día
SCREENER_MAX_CANDIDATES=40     # tope de candidatos que pasan al scan técnico por corrida
SCREENER_MIN_RR=2              # R/R mínimo del setup para considerar un candidato operable

# Barrido semanal de bases (sábados 14:00)
SWEEP_MIN_DOLLAR_VOLUME=10000000   # piso de liquidez ($/día promedio 20d)

# Stop perforado: comprar bajo un stop reciente del propio sistema midió 32% win / -0.15R (patología NEM)
HOY_STOP_BREACH_LOOKBACK_DAYS=30   # ventana de stops previos contra los que se compara el precio

# Módulo Cartera (modo aportes) — bandas por capa, advisory
CARTERA_TARGET_NUCLEO=55       # % objetivo de índice amplio
CARTERA_TARGET_COBERTURA=12    # % objetivo de cobertura (oro/bonos)
CARTERA_MAX_RIESGO=35          # % máximo tolerado en capa riesgo (tesis+satélite)
CARTERA_MAX_POSICION=20        # % máximo de una posición individual

# Modo "hoy no se opera": se activa con menos de N setups válidos en el scan del día
NO_TRADE_MIN_SETUPS=3

# Riesgo máximo del setup (% entre entrada y stop) — por encima, setupQuality='invalid' y BUY degrada a WATCH
MAX_SETUP_RISK_PCT=10

# Análisis LLM de noticias (etapa news del pipeline)
NEWS_LLM_CONCURRENCY=3         # batches LLM en paralelo (antes: secuencial)
NEWS_BATCH_DELAY_MS=2000       # pausa por worker entre batches (protección rate-limit)
NEWS_BATCH_SIZE=               # override del tamaño de batch; vacío = heurística (LMSTUDIO_URL→6, cloud→15)
NEWS_TICKER_VALIDATION_CAP=50  # máx. tickers fuera de universo a validar contra Yahoo por corrida (el resto se descarta y loguea)

# Precios / Yahoo — batch, cache y concurrencia
YAHOO_QUOTE_CHUNK=30           # símbolos por request en el endpoint batch v7/quote; >~40 tiende a 503ear
YAHOO_MAX_CONCURRENT=6         # techo global de conexiones concurrentes a Yahoo (gate compartido, carril de prioridad para navegación interactiva)
PRICE_CACHE_TTL_MS=15000       # TTL del cache por símbolo (el ticker lo warmea → detalle de símbolo no repega a Yahoo)
HISTORY_CACHE_TTL_MS=60000     # TTL del cache de OHLC histórico por (símbolo, rango, intervalo)

# Streaming de precios por WebSocket
WS_PRICES_INTERVAL_MS=30000    # intervalo del broadcast; con el batch v7 el fan-out del universo drena en segundos, no ~30s

# Motor de tesis (generador semanal LLM, lunes 10:00 UTC)
THESIS_MACRO_LOOKBACK_DAYS=7       # ventana de eventos macro que se le pasan al LLM como insumo
THESIS_TOP_OPPORTUNITIES_LIMIT=10  # tope de filas del último scan que entran al prompt
THESIS_MAX_PER_RUN=3               # tope de tesis que se persisten por corrida (el resto se trunca y loguea)
THESIS_LLM_MAX_TOKENS=10000        # presupuesto de output del LLM — Gemini 2.5 gasta parte en "thinking" interno antes del JSON visible; con 4096 la corrida real del 2026-07-23 se truncó a mitad de la narrative y perdió los campos requeridos posteriores (0 tesis generadas, 1 descartada)
